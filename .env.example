# FlowForge Environment Configuration
# Copy this file to .env and fill in real values before running.
# NEVER commit .env to version control.

# ── Application ────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=console
ENABLE_DOCS=true
APP_BASE_URL=http://localhost:3000

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://flowforge:change-me@postgres:5432/flowforge
POSTGRES_USER=flowforge
POSTGRES_PASSWORD=change-me
POSTGRES_DB=flowforge
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10

# ── Redis ──────────────────────────────────────────────────────────────────────
# db 1: rate limits, denylist, webhook dedupe, heartbeats, caches
REDIS_URL=redis://redis:6379/1
# db 0: Celery broker
CELERY_BROKER_URL=redis://redis:6379/0
# db 2: Celery result backend (tasks use ignore_result, this is a backstop)
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── Security ───────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Multiple comma-separated keys supported for rotation (first key encrypts, all decrypt)
ENCRYPTION_KEY=generate-with-python-cryptography-fernet-generate-key

# ── CORS ───────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000
TRUSTED_PROXY_COUNT=0

# ── Email (Mailpit for development) ────────────────────────────────────────────
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@flowforge.local
SMTP_STARTTLS=false
EMAIL_DAILY_LIMIT_PER_USER=100

# ── Workers ────────────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=4

# ── SSRF Override (tests only — NEVER true in production) ─────────────────────
ALLOW_PRIVATE_NETWORK_REQUESTS=false

# ── Admin Seeding (optional — creates first admin on boot if no admin exists) ──
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-too
